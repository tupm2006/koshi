# Koshi backend configuration.
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# ---- Deployment -------------------------------------------------------------
# "development" relaxes the startup safety checks. Anything else is treated as
# production: the app refuses to boot with development defaults still in force.
ENVIRONMENT=development

# ---- Security (required outside development) --------------------------------
# Generate with:  openssl rand -hex 32
# Rotating this invalidates every existing session — all users must sign in again.
JWT_SECRET=

# Comma-separated allowed origins. "*" is rejected outside development.
CORS_ORIGINS=*

# Accept Google ID tokens whose signature could not be verified. This lets
# anyone forge a session for any email address. Required only by the offline
# test-suite; never enable it on a real deployment.
ALLOW_UNVERIFIED_GOOGLE_TOKENS=false

# Seed demo accounts with the known password "koshi123". Development only.
SEED_DEMO_DATA=true

# ---- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/koshi.db

# ---- AI cascade (all optional; the deterministic fallback needs none) --------
# Tier 1 fires whenever AI_API_KEY is set (any OpenAI-compatible vendor; default Groq).
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL_NAME=openai/gpt-oss-120b

# Tier 2: local Ollama.
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b
